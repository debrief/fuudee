{
  "name": "debrief",
  "displayName": "Debrief",
  "description": "Maritime exercise analysis: catalogues of plots, a map, and Python analysis tools",
  "version": "0.0.1",
  "publisher": "debrief",
  "license": "EPL-2.0",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Visualization", "Data Science"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {"id": "debrief", "title": "Debrief", "icon": "media/debrief.svg"}
      ]
    },
    "views": {
      "debrief": [
        {"type": "webview", "id": "debrief.time", "name": "Time"},
        {"type": "webview", "id": "debrief.tote", "name": "Tote", "visibility": "collapsed"},
        {"id": "debrief.catalogues", "name": "Catalogues"},
        {"id": "debrief.outline", "name": "Outline"},
        {"type": "webview", "id": "debrief.timeline", "name": "Timeline"},
        {"id": "debrief.tools", "name": "Tools"},
        {"id": "debrief.history", "name": "History"}
      ]
    },
    "viewsWelcome": [
      {
        "view": "debrief.catalogues",
        "contents": "Debrief keeps plots in catalogues: folders you choose.\n[Add catalogue folder](command:debrief.addCatalogue)\n[Create catalogue](command:debrief.createCatalogue)"
      },
      {
        "view": "debrief.outline",
        "contents": "Open a plot from a catalogue to see its tracks, annotations and sensor data here."
      },
      {
        "view": "debrief.history",
        "contents": "Every change to the open plot appears here. Undo returns the plot to an earlier step; nothing is lost."
      }
    ],
    "commands": [
      {"command": "debrief.addCatalogue", "title": "Add catalogue folder…", "category": "Debrief", "icon": "$(folder-opened)"},
      {"command": "debrief.createCatalogue", "title": "Create catalogue…", "category": "Debrief", "icon": "$(new-folder)"},
      {"command": "debrief.importRep", "title": "Import plot file (REP or .dpf)…", "category": "Debrief", "icon": "$(cloud-download)"},
      {"command": "debrief.addPlotFile", "title": "Add a plot file…", "category": "Debrief", "icon": "$(file-add)"},
      {"command": "debrief.refresh", "title": "Refresh", "category": "Debrief", "icon": "$(refresh)"},
      {"command": "debrief.openPlot", "title": "Open plot", "category": "Debrief"},
      {"command": "debrief.select", "title": "Select features", "category": "Debrief"},
      {"command": "debrief.clearSelection", "title": "Clear selection", "category": "Debrief", "icon": "$(clear-all)"},
      {"command": "debrief.showToolForm", "title": "Open tool", "category": "Debrief"},
      {"command": "debrief.runTool", "title": "Run tool", "category": "Debrief"},
      {"command": "debrief.restartTools", "title": "Restart tool service", "category": "Debrief"},
      {"command": "debrief.undo", "title": "Undo last change to plot", "category": "Debrief", "icon": "$(discard)", "enablement": "debrief.canUndo"},
      {"command": "debrief.redo", "title": "Redo change to plot", "category": "Debrief", "icon": "$(redo)", "enablement": "debrief.canRedo"},
      {"command": "debrief.setColour", "title": "Change colour…", "category": "Debrief", "icon": "$(symbol-color)"},
      {"command": "debrief.hide", "title": "Hide on map", "category": "Debrief", "icon": "$(eye-closed)"},
      {"command": "debrief.addAnnotation", "title": "Add annotation…", "category": "Debrief", "icon": "$(add)", "enablement": "debrief.plotOpen"},
      {"command": "debrief.editAnnotation", "title": "Change annotation…", "category": "Debrief", "icon": "$(edit)"},
      {"command": "debrief.deleteAnnotation", "title": "Delete annotation", "category": "Debrief", "icon": "$(trash)"},
      {"command": "debrief.toggleNorthArrow", "title": "North arrow", "category": "Debrief", "enablement": "debrief.plotOpen", "toggled": {"condition": "debrief.northArrow"}},
      {"command": "debrief.moveTrack", "title": "Move track…", "category": "Debrief", "icon": "$(move)"},
      {"command": "debrief.rotateTrack", "title": "Rotate track…", "category": "Debrief", "icon": "$(sync)"},
      {"command": "debrief.shearTrack", "title": "Shear track…", "category": "Debrief"},
      {"command": "debrief.stretchTrack", "title": "Stretch track…", "category": "Debrief"},
      {"command": "debrief.splitTrack", "title": "Split track at current time…", "category": "Debrief", "icon": "$(split-horizontal)"},
      {"command": "debrief.mergeTracks", "title": "Merge selected tracks", "category": "Debrief", "icon": "$(merge)"},
      {"command": "debrief.editTrack", "title": "Change track", "category": "Debrief"},
      {"command": "debrief.removeJumps", "title": "Find and remove jumps…", "category": "Debrief", "icon": "$(debug-step-over)"},
      {"command": "debrief.smoothTrack", "title": "Smooth track…", "category": "Debrief", "icon": "$(pulse)"},
      {"command": "debrief.markFix", "title": "Fixes: colour, label or comment…", "category": "Debrief", "icon": "$(list-unordered)"},
      {"command": "debrief.moveFix", "title": "Move a fix…", "category": "Debrief", "icon": "$(location)"},
      {"command": "debrief.plottingMode", "title": "Plot over the ground or by dead reckoning…", "category": "Debrief"},
      {"command": "debrief.askTrackImportMode", "title": "Ask again whether imported tracks are OTG or DR", "category": "Debrief"},
      {"command": "debrief.goToTime", "title": "Go to this time", "category": "Debrief"},
      {"command": "debrief.addNarrative", "title": "Add narrative entry…", "category": "Debrief", "icon": "$(comment)", "enablement": "debrief.plotOpen"},
      {"command": "debrief.editNarrative", "title": "Change narrative entry…", "category": "Debrief"},
      {"command": "debrief.deleteNarrative", "title": "Delete narrative entry", "category": "Debrief"},
      {"command": "debrief.importNarrative", "title": "Read narrative into this plot (REP)…", "category": "Debrief", "icon": "$(cloud-download)", "enablement": "debrief.plotOpen"},
      {"command": "debrief.show", "title": "Show on map", "category": "Debrief", "icon": "$(eye)"},
        {"command": "debrief.goToStep", "title": "Go back to this step", "category": "Debrief"},
      {"command": "debrief.redoToStep", "title": "Redo up to this step", "category": "Debrief"},
      {"command": "debrief.tote.setPrimary", "title": "Set as Tote primary", "category": "Debrief", "enablement": "debrief.plotOpen"},
      {"command": "debrief.tote.add", "title": "Add to Tote", "category": "Debrief", "enablement": "debrief.plotOpen"},
      {"command": "debrief.tote.remove", "title": "Remove from Tote", "category": "Debrief", "enablement": "debrief.plotOpen"},
      {"command": "debrief.setTote", "title": "Set the Tote's tracks", "category": "Debrief"},
      {"command": "debrief.contextTracks.visible", "title": "Context tracks: Visible", "category": "Debrief", "enablement": "debrief.contextTracks", "toggled": {"condition": "debrief.contextTracks == visible"}},
      {"command": "debrief.contextTracks.faint", "title": "Context tracks: Faint", "category": "Debrief", "enablement": "debrief.contextTracks", "toggled": {"condition": "debrief.contextTracks == faint"}},
      {"command": "debrief.contextTracks.hidden", "title": "Context tracks: Hidden", "category": "Debrief", "enablement": "debrief.contextTracks", "toggled": {"condition": "debrief.contextTracks == hidden"}}
    ],
    "menus": {
      "view/title": [
        {"command": "debrief.contextTracks.visible", "when": "view == debrief.time && debrief.contextTracks", "group": "1_context@1"},
        {"command": "debrief.contextTracks.faint", "when": "view == debrief.time && debrief.contextTracks", "group": "1_context@2"},
        {"command": "debrief.contextTracks.hidden", "when": "view == debrief.time && debrief.contextTracks", "group": "1_context@3"},
        {"command": "debrief.importRep", "when": "view == debrief.catalogues", "group": "navigation@1"},
        {"command": "debrief.addPlotFile", "when": "view == debrief.catalogues", "group": "navigation@2"},
        {"command": "debrief.addCatalogue", "when": "view == debrief.catalogues", "group": "navigation@3"},
        {"command": "debrief.refresh", "when": "view == debrief.catalogues", "group": "navigation@4"},
        {"command": "debrief.addAnnotation", "when": "view == debrief.outline", "group": "navigation@0"},
        {"command": "debrief.clearSelection", "when": "view == debrief.outline", "group": "navigation@1"},
        {"command": "debrief.toggleNorthArrow", "when": "view == debrief.outline", "group": "2_furniture@1"},
        {"command": "debrief.addNarrative", "when": "view == debrief.timeline", "group": "navigation@1"},
        {"command": "debrief.addAnnotation", "when": "view == debrief.timeline", "group": "navigation@2"},
        {"command": "debrief.importNarrative", "when": "view == debrief.timeline", "group": "navigation@3"},
        {"command": "debrief.undo", "when": "view == debrief.history", "group": "navigation@1"},
        {"command": "debrief.redo", "when": "view == debrief.history", "group": "navigation@2"}
      ],
      "view/item/context": [
        {"command": "debrief.importRep", "when": "view == debrief.catalogues && viewItem == catalogue", "group": "1_import"},
        {"command": "debrief.addPlotFile", "when": "view == debrief.catalogues && viewItem == catalogue", "group": "1_import"},
        {"command": "debrief.setColour", "when": "view == debrief.outline && viewItem =~ /^feature-track/", "group": "1_presentation@1"},
        {"command": "debrief.hide", "when": "view == debrief.outline && viewItem =~ /^feature-/ && viewItem =~ /^(?!.*-hidden$)/", "group": "1_presentation@2"},
        {"command": "debrief.show", "when": "view == debrief.outline && viewItem =~ /-hidden$/", "group": "1_presentation@2"},
        {"command": "debrief.moveTrack", "when": "view == debrief.outline && viewItem =~ /^feature-track/", "group": "0_track@1"},
        {"command": "debrief.rotateTrack", "when": "view == debrief.outline && viewItem =~ /^feature-track/", "group": "0_track@2"},
        {"command": "debrief.shearTrack", "when": "view == debrief.outline && viewItem =~ /^feature-track/", "group": "0_track@3"},
        {"command": "debrief.stretchTrack", "when": "view == debrief.outline && viewItem =~ /^feature-track/", "group": "0_track@4"},
        {"command": "debrief.splitTrack", "when": "view == debrief.outline && viewItem =~ /^feature-track/", "group": "0_track@5"},
        {"command": "debrief.mergeTracks", "when": "view == debrief.outline && viewItem =~ /^feature-track/", "group": "0_track@6"},
        {"command": "debrief.removeJumps", "when": "view == debrief.outline && viewItem =~ /^feature-track/", "group": "0_track@7"},
        {"command": "debrief.smoothTrack", "when": "view == debrief.outline && viewItem =~ /^feature-track/", "group": "0_track@8"},
        {"command": "debrief.markFix", "when": "view == debrief.outline && viewItem =~ /^feature-track/", "group": "0_track@9"},
        {"command": "debrief.moveFix", "when": "view == debrief.outline && viewItem =~ /^feature-track/", "group": "0_track@10"},
        {"command": "debrief.plottingMode", "when": "view == debrief.outline && viewItem =~ /^feature-track/", "group": "0_track@11"},
        {"command": "debrief.tote.setPrimary", "when": "view == debrief.outline && viewItem =~ /^feature-track/", "group": "2_tote@1"},
        {"command": "debrief.tote.add", "when": "view == debrief.outline && viewItem =~ /^feature-track/", "group": "2_tote@2"},
        {"command": "debrief.tote.remove", "when": "view == debrief.outline && viewItem =~ /^feature-track/", "group": "2_tote@3"},
        {"command": "debrief.editAnnotation", "when": "view == debrief.outline && viewItem =~ /^feature-annotation/", "group": "0_annotation@1"},
        {"command": "debrief.deleteAnnotation", "when": "view == debrief.outline && viewItem =~ /^feature-annotation/", "group": "0_annotation@2"},
        {"command": "debrief.goToStep", "when": "view == debrief.history && viewItem == step-applied", "group": "1_history"},
        {"command": "debrief.redoToStep", "when": "view == debrief.history && viewItem == step-undone", "group": "1_history"}
      ],
      "commandPalette": [
        {"command": "debrief.openPlot", "when": "false"},
        {"command": "debrief.select", "when": "false"},
        {"command": "debrief.showToolForm", "when": "false"},
        {"command": "debrief.runTool", "when": "false"},
        {"command": "debrief.goToTime", "when": "false"},
        {"command": "debrief.editNarrative", "when": "false"},
        {"command": "debrief.deleteNarrative", "when": "false"},
        {"command": "debrief.editTrack", "when": "false"},
        {"command": "debrief.goToStep", "when": "false"},
        {"command": "debrief.redoToStep", "when": "false"},
        {"command": "debrief.setTote", "when": "false"}
      ]
    },
    "keybindings": [
      {"command": "debrief.undo", "key": "ctrl+z", "mac": "cmd+z", "when": "!inputFocus && !inQuickOpen && activeWebviewPanelId == 'debrief.map' || !inputFocus && focusedView == debrief.history || !inputFocus && focusedView == debrief.outline"},
      {"command": "debrief.redo", "key": "ctrl+shift+z", "mac": "cmd+shift+z", "when": "!inputFocus && !inQuickOpen && activeWebviewPanelId == 'debrief.map' || !inputFocus && focusedView == debrief.history || !inputFocus && focusedView == debrief.outline"},
      {"command": "debrief.redo", "key": "ctrl+y", "when": "!inputFocus && !inQuickOpen && activeWebviewPanelId == 'debrief.map' || !inputFocus && focusedView == debrief.history || !inputFocus && focusedView == debrief.outline"}
    ],
    "configuration": {
      "title": "Debrief",
      "properties": {
        "debrief.python": {
          "type": "string",
          "default": "",
          "markdownDescription": "Python interpreter with Debrief's Python packages installed. Leave empty to use `python3`, or `python` on Windows."
        },
        "debrief.toolTimeout": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "markdownDescription": "Seconds a tool may run before Debrief stops it."
        },
        "debrief.trackImportMode": {
          "type": "string",
          "enum": ["ask", "otg", "dr"],
          "enumDescriptions": ["Ask, for each track imported, whether it is plotted over the ground or by dead reckoning.", "Plot every track imported over the ground (OTG): each fix where it was logged.", "Plot every track imported by dead reckoning (DR): from the first fix, by each fix's course and speed."],
          "default": "ask",
          "scope": "application",
          "markdownDescription": "How tracks imported from REP files are plotted. Set when you choose *Use this choice for future imports*; set it back to `ask` (or run **Debrief: Ask again whether imported tracks are OTG or DR**) to be asked for each track again. Kept with your Debrief settings, never in a plot."
        },
        "debrief.map.minimumContextContrast": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Draw tracks outside the time window as Visible (at least 3:1 against the map) even on a plot set to Faint: a plot can never show context fainter than Visible. A plot set to Hidden still hides them."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "vscode:prepublish": "node scripts/build.mjs --production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/build.mjs && node dist-test/run.js",
    "test:play": "node test/play/play.mjs ../site/docs/play ../site/site",
    "check:theme": "node scripts/check-theme.mjs",
    "check:language": "node scripts/check-language.mjs"
  },
  "dependencies": {
    "@debrief/config": "file:../ts/config",
    "@debrief/kernel": "file:../ts/kernel",
    "@debrief/schemas": "file:../ts/schemas",
    "geographiclib-geodesic": "2.2.0",
    "leaflet": "1.9.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vscrui": "1.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.25.10",
    "playwright": "1.56.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
