{
  "description": "Where each platform keeps the per-user configuration file (SEC-06). Python and TypeScript are both held to these cases.",
  "cases": [
    {
      "name": "Linux default",
      "platform": "linux",
      "home": "/home/analyst",
      "env": {},
      "expected": "/home/analyst/.config/debrief/config.json"
    },
    {
      "name": "Linux with XDG_CONFIG_HOME",
      "platform": "linux",
      "home": "/home/analyst",
      "env": {"XDG_CONFIG_HOME": "/srv/config"},
      "expected": "/srv/config/debrief/config.json"
    },
    {
      "name": "Linux ignores a relative XDG_CONFIG_HOME, as the XDG specification requires",
      "platform": "linux",
      "home": "/home/analyst",
      "env": {"XDG_CONFIG_HOME": "config"},
      "expected": "/home/analyst/.config/debrief/config.json"
    },
    {
      "name": "macOS",
      "platform": "darwin",
      "home": "/Users/analyst",
      "env": {},
      "expected": "/Users/analyst/Library/Application Support/Debrief/config.json"
    },
    {
      "name": "Windows with APPDATA",
      "platform": "win32",
      "home": "C:\\Users\\analyst",
      "env": {"APPDATA": "C:\\Users\\analyst\\AppData\\Roaming"},
      "expected": "C:\\Users\\analyst\\AppData\\Roaming\\Debrief\\config.json"
    },
    {
      "name": "Windows without APPDATA",
      "platform": "win32",
      "home": "C:\\Users\\analyst",
      "env": {},
      "expected": "C:\\Users\\analyst\\AppData\\Roaming\\Debrief\\config.json"
    },
    {
      "name": "DEBRIEF_CONFIG overrides the platform default",
      "platform": "win32",
      "home": "C:\\Users\\analyst",
      "env": {"APPDATA": "C:\\Users\\analyst\\AppData\\Roaming", "DEBRIEF_CONFIG": "D:\\debrief\\config.json"},
      "expected": "D:\\debrief\\config.json"
    },
    {
      "name": "DEBRIEF_CONFIG on Linux",
      "platform": "linux",
      "home": "/home/analyst",
      "env": {"DEBRIEF_CONFIG": "/tmp/test/config.json"},
      "expected": "/tmp/test/config.json"
    }
  ]
}
